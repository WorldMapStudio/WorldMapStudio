{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Godot",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "godot",
            "args": [
                "."
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Attach to Godot",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "Run Release",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "export release",
            "program": "${workspaceFolder}/build/release/WorldMapStudio.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        }
    ]
}
