<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
  The editor build of Godot only ever loads assemblies from the Debug output slot, so
  ExportRelease code can otherwise only be run through a full export. `-p:Optimized=true`
  puts optimized IL in that slot instead. The separate obj dir keeps the optimized and
  unoptimized builds from invalidating each other's incremental state.
  -->
  <PropertyGroup Condition=" '$(Optimized)' == 'true' ">
    <Optimize>true</Optimize>
    <IntermediateOutputPath>$(GodotProjectDir).godot/mono/temp/obj/DebugOptimized/</IntermediateOutputPath>
  </PropertyGroup>

  <!--
  Builds core with every plugin glob excluded, to prove core carries no compile-time dependency on a
  plugin. Separate obj/bin slots for the same reason as the Optimized switch above: the Godot editor
  always loads the Debug bin slot, so a core-only build must not overwrite it.
  -->
  <PropertyGroup Condition=" '$(WmsCoreOnly)' == 'true' ">
    <IntermediateOutputPath>$(GodotProjectDir).godot/mono/temp/obj/CoreOnly/</IntermediateOutputPath>
    <OutputPath>$(GodotProjectDir).godot/mono/temp/bin/CoreOnly/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DoltHub.Doltlite" Version="0.50.12" />
    <PackageReference Include="ImGui.NET.Branches.Docking" Version="1.88.0" />
    <PackageReference Include="Jint" Version="4.15.3" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.661903" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="8.0.3" />
  </ItemGroup>

  <!--
  DoltHub.Doltlite's win-x64 native library is a cgo build that dynamically links two MinGW-w64
  runtime DLLs (libgcc_s_seh-1.dll, libwinpthread-1.dll) the NuGet package does not ship. Without
  them next to doltlite.dll, LoadLibrary fails with "module not found" the moment nothing on the
  process's PATH happens to supply them (as Godot.exe launched normally does not) — confirmed by
  reproducing and fixing the exact failure outside Godot before adding this. Windows' default DLL
  search order checks the loading module's own directory, so copying them alongside doltlite.dll
  in every output slot is enough; no code-side loader change is needed.
  -->
  <ItemGroup>
    <None Include="native/win-x64/libgcc_s_seh-1.dll" Link="runtimes/win-x64/native/libgcc_s_seh-1.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="native/win-x64/libwinpthread-1.dll" Link="runtimes/win-x64/native/libwinpthread-1.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="analyzer/WorldMapStudio.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Compile Remove="analyzer/**" />
  </ItemGroup>
  <ItemGroup Condition=" '$(WmsCoreOnly)' != 'true' ">
    <Compile Include="../WorldMapStudioPlugins/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition=" '$(WmsCoreOnly)' != 'true' ">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WorldMapStudio.PluginsDirectory</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../WorldMapStudioPlugins'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
