<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
  The editor build of Godot only ever loads assemblies from the Debug output slot, so
  ExportRelease code can otherwise only be run through a full export. `-p:Optimized=true`
  puts optimized IL in that slot instead. The separate obj dir keeps the optimized and
  unoptimized builds from invalidating each other's incremental state.
  -->
  <PropertyGroup Condition=" '$(Optimized)' == 'true' ">
    <Optimize>true</Optimize>
    <IntermediateOutputPath>$(GodotProjectDir).godot\mono\temp\obj\DebugOptimized\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET.Branches.Docking" Version="1.88.0" />
    <PackageReference Include="Jint" Version="4.15.3" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.661903" />
    <PackageReference Include="MySqlConnector" Version="2.3.5" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="analyzer\WorldMapStudio.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Compile Include=".local\Plugins\**\*.cs" />
    <Compile Include="Plugins\**\*.cs" />
    <Compile Include="..\WorldMapStudioPlugins\**\*.cs" />
    <Compile Remove="analyzer\**" />
  </ItemGroup>
</Project>
